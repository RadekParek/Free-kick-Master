  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.0",
    "@playwright/test": "^1.56.0",
    "@sparticuz/chromium": "^138.0.0",
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
